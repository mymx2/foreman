.page {
    box-sizing: border-box;
    min-height: 100vh;
    padding: 48rpx 32rpx 150rpx;
}

.hero {
    display: flex;
    flex-direction: column;
    margin-bottom: 32rpx;
}

.eyebrow {
    color: #1769e0;
    font-size: 22rpx;
    font-weight: 600;
    letter-spacing: 3rpx;
}

.title {
    margin-top: 16rpx;
    font-size: 48rpx;
    font-weight: 700;
    line-height: 1.25;
}

.subtitle {
    margin-top: 12rpx;
    color: #646a73;
    font-size: 28rpx;
}

.state-card,
.content-card {
    box-sizing: border-box;
    padding: 32rpx;
    border: 2rpx solid #e5e8eb;
    border-radius: 24rpx;
    background: #ffffff;
}

.state-card {
    display: flex;
    min-height: 320rpx;
    align-items: center;
    flex-direction: column;
    justify-content: center;
    text-align: center;
}

.state-card-error {
    border-color: #ffd8d6;
}

.spinner {
    width: 44rpx;
    height: 44rpx;
    border: 6rpx solid #dbe8fb;
    border-top-color: #1769e0;
    border-radius: 50%;
}

.state-icon {
    color: #1769e0;
    font-size: 56rpx;
    font-weight: 700;
}

.state-title {
    margin-top: 20rpx;
    font-size: 34rpx;
    font-weight: 600;
}

.state-description {
    margin-top: 12rpx;
    color: #646a73;
    font-size: 26rpx;
    line-height: 1.6;
}

.primary-button {
    margin-top: 28rpx;
    background: #1769e0;
    color: #ffffff;
    font-size: 28rpx;
}

.list-item {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 24rpx 0;
    border-top: 2rpx solid #f0f1f2;
}

.list-item:first-child {
    border-top: 0;
    padding-top: 8rpx;
}

.list-main {
    flex: 1;
    padding-right: 20rpx;
}

.item-title {
    display: block;
    font-size: 30rpx;
    font-weight: 600;
    color: #1f2329;
}

.item-note {
    display: block;
    margin-top: 10rpx;
    color: #646a73;
    font-size: 26rpx;
}

.item-time {
    display: block;
    margin-top: 8rpx;
    color: #8f959e;
    font-size: 22rpx;
}

.delete-button {
    margin: 0;
    background: #fff0ef;
    color: #d4380d;
    font-size: 24rpx;
}

.floating-add {
    position: fixed;
    right: 36rpx;
    bottom: 56rpx;
    width: 96rpx;
    height: 96rpx;
    line-height: 96rpx;
    padding: 0;
    border-radius: 50%;
    background: #1769e0;
    color: #ffffff;
    font-size: 56rpx;
    box-shadow: 0 16rpx 28rpx rgba(23, 105, 224, 0.3);
}

.editor-mask {
    position: fixed;
    top: 0;
    right: 0;
    bottom: 0;
    left: 0;
    background: rgba(31, 35, 41, 0.36);
}

.editor-sheet {
    position: fixed;
    right: 0;
    bottom: 0;
    left: 0;
    box-sizing: border-box;
    padding: 36rpx 32rpx 48rpx;
    border-radius: 28rpx 28rpx 0 0;
    background: #ffffff;
}

.sheet-title {
    display: block;
    font-size: 34rpx;
    font-weight: 600;
}

.sheet-error {
    display: block;
    margin-top: 18rpx;
    padding: 14rpx 18rpx;
    border-radius: 14rpx;
    background: #fff0ef;
    color: #d4380d;
    font-size: 24rpx;
}

.field-group {
    margin-top: 24rpx;
}

.field-label {
    display: block;
    margin-bottom: 12rpx;
    font-size: 26rpx;
    color: #1f2329;
}

.required {
    color: #d4380d;
}

.field-input,
.field-textarea {
    box-sizing: border-box;
    width: 100%;
    border: 2rpx solid #d6d8dc;
    border-radius: 16rpx;
    padding: 18rpx 20rpx;
    background: #ffffff;
    color: #1f2329;
    font-size: 28rpx;
}

.field-textarea {
    min-height: 160rpx;
}

.sheet-actions {
    display: flex;
    margin-top: 32rpx;
}

.sheet-button {
    flex: 1;
    margin-top: 0;
    background: #f2f3f5;
    color: #1f2329;
    font-size: 28rpx;
}

.sheet-button + .sheet-button {
    margin-left: 16rpx;
}
