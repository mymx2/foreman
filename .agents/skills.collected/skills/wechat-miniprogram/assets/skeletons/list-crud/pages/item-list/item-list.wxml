<view class="page">
    <view class="hero">
        <text class="eyebrow">LIST CRUD</text>
        <text class="title">{{title}}</text>
        <text class="subtitle">{{subtitle}}</text>
    </view>

    <view class="state-card" wx:if="{{viewState === 'loading'}}">
        <view class="spinner"></view>
        <text class="state-title">正在加载</text>
        <text class="state-description">请稍候，列表马上准备好。</text>
    </view>

    <view class="state-card" wx:elif="{{viewState === 'empty'}}">
        <text class="state-icon">○</text>
        <text class="state-title">暂无数据</text>
        <text class="state-description">点击右下角 + 创建第一条记录。</text>
    </view>

    <view class="state-card state-card-error" wx:elif="{{viewState === 'error'}}">
        <text class="state-icon">!</text>
        <text class="state-title">加载失败</text>
        <text class="state-description">{{errorMessage}}</text>
        <button class="primary-button" bindtap="handleRetry">重试</button>
    </view>

    <view class="content-card" wx:else>
        <view class="list-item" wx:for="{{items}}" wx:key="id">
            <view class="list-main" data-id="{{item.id}}" bindtap="openEdit">
                <text class="item-title">{{item.title}}</text>
                <text class="item-note">{{item.noteText}}</text>
                <text class="item-time">最近更新：{{item.updatedText}}</text>
            </view>
            <button class="delete-button" size="mini" data-id="{{item.id}}" catchtap="handleDelete">删除</button>
        </view>
    </view>

    <button class="floating-add" bindtap="openCreate">+</button>

    <view class="editor-mask" wx:if="{{showEditor}}" bindtap="closeEditor"></view>
    <view class="editor-sheet" wx:if="{{showEditor}}">
        <text class="sheet-title">{{editorTitle}}</text>

        <text class="sheet-error" wx:if="{{formError !== ''}}">{{formError}}</text>

        <view class="field-group">
            <text class="field-label">标题 <text class="required">*</text></text>
            <input class="field-input" placeholder="请输入标题" value="{{formTitle}}" bindinput="handleTitleInput" maxlength="40" />
        </view>

        <view class="field-group">
            <text class="field-label">备注</text>
            <textarea class="field-textarea" placeholder="可选，补充说明信息" value="{{formNote}}" bindinput="handleNoteInput" maxlength="200" />
        </view>

        <view class="sheet-actions">
            <button class="sheet-button" bindtap="closeEditor" disabled="{{submitting}}">取消</button>
            <button class="sheet-button primary-button" bindtap="handleSave" loading="{{submitting}}" disabled="{{submitting}}">保存</button>
        </view>
    </view>
</view>
