.page {
    box-sizing: border-box;
    min-height: 100vh;
    padding: 80rpx 32rpx 64rpx;
}

.result-card {
    box-sizing: border-box;
    padding: 48rpx 32rpx;
    border: 2rpx solid #e5e8eb;
    border-radius: 24rpx;
    background: #ffffff;
    text-align: center;
}

.result-icon {
    position: relative;
    width: 132rpx;
    height: 132rpx;
    margin: 0 auto;
    border-radius: 50%;
}

.result-icon-success {
    background: #e8f3ff;
}

.result-icon-fail {
    background: #fff0ef;
}

.icon-check,
.icon-close {
    position: relative;
    width: 100%;
    height: 100%;
}

.icon-check-short,
.icon-check-long {
    position: absolute;
    border-radius: 999rpx;
    background: #1769e0;
    transform-origin: center;
}

.icon-check-short {
    left: 40rpx;
    top: 72rpx;
    width: 14rpx;
    height: 34rpx;
    transform: rotate(-45deg);
}

.icon-check-long {
    left: 63rpx;
    top: 56rpx;
    width: 14rpx;
    height: 58rpx;
    transform: rotate(45deg);
}

.icon-close-line {
    position: absolute;
    left: 60rpx;
    top: 35rpx;
    width: 12rpx;
    height: 64rpx;
    border-radius: 999rpx;
    background: #d4380d;
    transform: rotate(45deg);
}

.icon-close-line-alt {
    transform: rotate(-45deg);
}

.result-title {
    display: block;
    margin-top: 32rpx;
    font-size: 38rpx;
    font-weight: 600;
    color: #1f2329;
}

.result-description {
    display: block;
    margin-top: 14rpx;
    color: #646a73;
    font-size: 26rpx;
    line-height: 1.6;
}

.action-group {
    margin-top: 40rpx;
}

.action-button {
    margin-top: 16rpx;
    background: #f2f3f5;
    color: #1f2329;
    font-size: 28rpx;
}

.action-button:first-child {
    margin-top: 0;
}

.action-primary {
    background: #1769e0;
    color: #ffffff;
}
