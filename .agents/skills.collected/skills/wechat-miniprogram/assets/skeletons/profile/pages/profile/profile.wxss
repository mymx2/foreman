.page {
    box-sizing: border-box;
    min-height: 100vh;
    padding: 48rpx 32rpx 64rpx;
    background: #f5f7fa;
}

.hero {
    display: flex;
    flex-direction: column;
    margin-bottom: 28rpx;
}

.eyebrow {
    color: #1769e0;
    font-size: 22rpx;
    font-weight: 600;
    letter-spacing: 3rpx;
}

.title {
    margin-top: 16rpx;
    font-size: 48rpx;
    font-weight: 700;
    line-height: 1.25;
    color: #1f2329;
}

.subtitle {
    margin-top: 12rpx;
    color: #646a73;
    font-size: 28rpx;
}

.profile-card,
.menu-card {
    box-sizing: border-box;
    padding: 32rpx;
    border: 2rpx solid #e5e8eb;
    border-radius: 24rpx;
    background: #ffffff;
}

.profile-card {
    display: flex;
    align-items: center;
    margin-bottom: 20rpx;
}

.avatar {
    width: 108rpx;
    height: 108rpx;
    border-radius: 50%;
    background: #1769e0;
    color: #ffffff;
    font-size: 44rpx;
    font-weight: 700;
    line-height: 108rpx;
    text-align: center;
    flex-shrink: 0;
}

.profile-main {
    flex: 1;
    margin-left: 24rpx;
}

.nickname {
    display: block;
    color: #1f2329;
    font-size: 34rpx;
    font-weight: 600;
}

.intro {
    display: block;
    margin-top: 10rpx;
    color: #646a73;
    font-size: 26rpx;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}

.menu-card {
    margin-top: 20rpx;
}

.menu-card:first-of-type {
    margin-top: 0;
}

.menu-item {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 24rpx 0;
    border-top: 2rpx solid #f0f1f2;
}

.menu-item:first-child {
    border-top: 0;
    padding-top: 8rpx;
}

.menu-item:last-child {
    padding-bottom: 8rpx;
}

.menu-text {
    color: #1f2329;
    font-size: 30rpx;
}

.menu-arrow {
    color: #8f959e;
    font-size: 32rpx;
}
